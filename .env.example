# Frontend only. Safe public URL for browser -> qitarot-api calls.
VITE_QITAROT_API_BASE_URL=http://localhost:8787
VITE_QITAROT_APP_SLUG=qitarot

# Worker secrets live in apps/qitarot-api/.dev.vars, not in the frontend:
# SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...
# CORS_ORIGIN=http://localhost:5173
